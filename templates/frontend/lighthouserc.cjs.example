// Lighthouse CI config — copy to frontend/lighthouserc.cjs in your project (.cjs, not .js:
// Vite projects set "type": "module", which breaks module.exports in a .js config).
// (and add @lhci/cli to frontend devDependencies).
// Audits the LOCAL production build on PUBLIC routes only.
// Authenticated pages need a puppeteer login script (LHCI docs: collect.puppeteerScript).
// Budgets mirror CONSTRAINTS.md: LCP < 2.5s, CLS < 0.1. INP is field-measured, not lab-asserted.
module.exports = {
  ci: {
    collect: {
      staticDistDir: './dist', // run from frontend/ after `npm run build`
      url: ['http://localhost/', 'http://localhost/login'], // adjust to your public routes
      numberOfRuns: 3,
      settings: { chromeFlags: '--no-sandbox --headless' }, // --no-sandbox required in Docker CI
    },
    assert: {
      assertions: {
        'largest-contentful-paint': ['error', { maxNumericValue: 2500 }],
        'cumulative-layout-shift': ['error', { maxNumericValue: 0.1 }],
        'categories:performance': ['warn', { minScore: 0.9 }],
        'categories:accessibility': ['error', { minScore: 0.9 }],
      },
    },
    upload: {
      target: 'filesystem',
      outputDir: './.lighthouserc',
    },
  },
};
