# Agent evals — the same job is folded into templates/gitlab/.gitlab-ci.yml.example
# (assist stage). This standalone file is for projects that include it separately.
# Agent-agnostic via $AGENT_BIN: "claude" (default) or "agent" (Cursor headless).
# Runs non-interactively on CLAUDE.md/skills/hooks changes + nightly schedule.
# Gate config changes on pass rate; each prod incident adds a permanent eval.
agent-evals:
  stage: test
  image: node:20-slim
  script:
    - |
      if [ "${AGENT_BIN:-claude}" = "agent" ]; then
        curl https://cursor.com/install -fsS | bash
        export PATH="$HOME/.local/bin:$PATH"
      else
        npm install -g @anthropic-ai/claude-code
      fi
    - chmod +x evals/check.sh
    - |
      for eval in evals/*.json; do
        $AGENT_BIN -p "$(jq -r '.prompt' $eval)" --output-format text > result.txt
        ./evals/check.sh "$eval" result.txt
      done
  rules:
    - if: $CI_PIPELINE_SOURCE == "schedule"
    - changes: [CLAUDE.md, AGENTS.md, .claude/**/*, .cursor/**/*, skills/**/*]
